# Copia este fichero a ".env" (en la raíz del proyecto) antes de "docker compose up".

# Secreto para firmar los tokens JWT de sesión de los jugadores. OBLIGATORIO: si se deja vacío,
# el contenedor `backend` falla al arrancar (ver Guía de Despliegue, "Diagnóstico de errores").
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=12h

# Duración de cada ronda del minijuego, en milisegundos. Se puede cambiar y reiniciar el
# contenedor `backend` SIN reconstruir la imagen (docker compose up -d, sin --build): afecta a
# la siguiente partida que se cree.
ROUND_DURATION_MS=8000

# Cada cuánto (ms) comprueba cada instancia de `backend` si hay jugadores suficientes en cola.
MATCHMAKER_INTERVAL_MS=1500

# Credenciales de PostgreSQL. Deben coincidir EXACTAMENTE entre lo que usa `db` para crear el
# usuario y lo que usa `backend` para conectarse (ver ejercicio de PGPASSWORD desincronizada).
PGUSER=arena
PGPASSWORD=arena
PGDATABASE=arena_royale

# Puerto del host donde se publica nginx (punto de entrada único de la aplicación).
HTTP_PORT=80
