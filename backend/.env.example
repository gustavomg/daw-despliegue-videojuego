# Copia este fichero a ".env" (dentro de backend/) si arrancas el backend suelto, sin Docker.
# Si usas Docker Compose, usa en su lugar el ".env.example" de la RAÍZ del proyecto: docker
# compose ya inyecta estas mismas variables como entorno del contenedor `backend`.
PORT=3000
NODE_ENV=production

# Secreto para firmar los tokens JWT de sesión de los jugadores. OBLIGATORIO: si está vacío o
# no se define, el backend falla al arrancar (ver src/config.js) - es un ejercicio de
# diagnóstico intencionado del módulo.
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=12h

# Duración de cada ronda de juego, en milisegundos. Se puede cambiar y reiniciar el contenedor
# `backend` SIN reconstruir la imagen: el valor se relee al crear cada partida nueva.
ROUND_DURATION_MS=8000

# Cada cuánto comprueba esta instancia si hay jugadores suficientes en la cola de matchmaking.
MATCHMAKER_INTERVAL_MS=1500

# Base de datos PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=arena
PGPASSWORD=arena
PGDATABASE=arena_royale

# Redis (cola de matchmaking, leaderboard en vivo y pub/sub entre réplicas del backend)
REDIS_HOST=localhost
REDIS_PORT=6379
